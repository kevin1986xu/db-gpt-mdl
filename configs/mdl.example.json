{
  "database": "mdl_demo",
  "revision": 1,
  "manifest": {
    "catalog": "wren",
    "schema": "main",
    "models": [
      {
        "name": "orders",
        "tableReference": {
          "schema": "main",
          "table": "raw_orders"
        },
        "primaryKey": "id",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "customer_id",
            "type": "integer"
          },
          {
            "name": "amount",
            "type": "double"
          },
          {
            "name": "cost",
            "type": "double"
          },
          {
            "name": "status",
            "type": "varchar"
          },
          {
            "name": "region",
            "type": "varchar"
          },
          {
            "name": "customer",
            "type": "customers",
            "relationship": "orders_customers"
          },
          {
            "name": "customer_name",
            "type": "varchar",
            "isCalculated": true,
            "expression": "customer.name"
          }
        ]
      },
      {
        "name": "customers",
        "tableReference": {
          "schema": "main",
          "table": "raw_customers"
        },
        "primaryKey": "id",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "varchar"
          },
          {
            "name": "region",
            "type": "varchar"
          },
          {
            "name": "email",
            "type": "varchar"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "orders_customers",
        "models": [
          "orders",
          "customers"
        ],
        "joinType": "MANY_TO_ONE",
        "condition": "orders.customer_id = customers.id"
      }
    ]
  },
  "policies": [
    {
      "username": "analyst",
      "models": {
        "orders": {
          "columns": [
            "id",
            "customer_id",
            "amount",
            "status",
            "region",
            "customer_name"
          ],
          "filters": [
            {
              "column": "region",
              "op": "eq",
              "value": "华东"
            }
          ]
        },
        "customers": {
          "columns": [
            "id",
            "name",
            "region"
          ],
          "filters": [
            {
              "column": "region",
              "op": "eq",
              "value": "华东"
            }
          ]
        }
      }
    }
  ]
}
